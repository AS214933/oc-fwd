# 反代监听地址
LISTEN_ADDR=:8080
# 上游 opencode ai zen 网关（OpenAI 兼容）
ZEN_UPSTREAM=https://opencode.ai/zen/v1
# 调用 opencode ai zen 的 key（可选；留空则匿名调用，例如 zen free 模型）
ZEN_UPSTREAM_API_KEY=
# 上游 socks5 代理（可选，socks5h 语义，DNS 由代理解析）
ZEN_SOCKS5=
# 优先 IPv6（默认 true）：本地解析域名、IPv6 优先、失败回退 IPv4；false = 透传主机名给代理解析
ZEN_IPV6_PREFER=true
# 强制 IPv6（默认 false）：只要有 IPv6 就只用 IPv6，绝不回退 IPv4。
# true = 只拨 AAAA 地址，目标只有 IPv4 时直接报错；配合 socks5 的 IPv6 出口使用。
ZEN_FORCE_IPV6=false
# 每请求新建连接（默认 true）：禁用连接复用，每个请求都走一条全新的 socks5 TCP 连接，
# 避免请求长时间复用同一条连接。
# false = 开启连接池复用（更快，但请求会复用同一连接）。
ZEN_ROTATE_IP=true
# 单次上游拨号超时（秒）：覆盖 socks5 握手与 TLS 握手；高并发下代理无响应时快速失败，
# 避免请求在拨号阶段堆积。默认 15。
ZEN_DIAL_TIMEOUT_SECONDS=15
# 本地 DNS 缓存 TTL（秒）：ZEN_IPV6_PREFER=true 时本地解析上游域名，高并发下大量重复
# 解析会被合并缓存；0 = 关闭缓存（每次请求都重新解析）。默认 60。
ZEN_DNS_CACHE_TTL_SECONDS=60
# API key 文件（一行一个）：配置后启用“匿名失败自动回退带 key 请求”。
# 上游只要不是 200（400/401/404/429/5xx 等）都会先重试、重试耗尽后自动改用文件中的
# key（随机轮换）在同一次请求内透明重试，不会把错误漏给用户；
# 匿名（无 key）请求连续失败 ZEN_NO_KEY_FAIL_THRESHOLD 次后同样自动切 key；
# 切换到 key 模式后先保持 ZEN_NO_KEY_RECOVERY_HOLD_SECONDS 秒（默认 300，即 5 分钟）
# 不做任何匿名探测；之后每 ZEN_NO_KEY_PROBE_SECONDS 秒发一次无 key 探测，
# 连续 ZEN_NO_KEY_RECOVERY_CONFIRMATIONS 次（默认 3）成功才切回匿名模式。
ZEN_API_KEYS_FILE=
ZEN_NO_KEY_FAIL_THRESHOLD=3
ZEN_NO_KEY_PROBE_SECONDS=3
ZEN_NO_KEY_RECOVERY_HOLD_SECONDS=300
ZEN_NO_KEY_RECOVERY_CONFIRMATIONS=3
# 模型状态上报：每次模型在 匿名 / API Key / 全部失败 之间切换就上报到状态页。
# 填 Status UI 的地址，例如 http://status-ui:8090（compose 内）或 http://127.0.0.1:8090。
ZEN_STATUS_URL=
# 与 Status UI 的 STATUS_EVENT_TOKEN 保持一致（可选，用于上报鉴权）
ZEN_STATUS_TOKEN=
# 强制统一为 Chat Completions 转发（默认 false）：
# true = 无论模型家族，所有请求都转成 Chat Completions 格式转发到上游 /v1/chat/completions
# false = 按模型自动选择上游协议（默认，见 ZEN_MODEL_ENDPOINTS / zen 官方模型表）
ZEN_FORCE_CHAT_COMPLETIONS=false
# 强制 Chat Completions 入站（默认 false）：
# true = 只接受 /v1/chat/completions，/v1/responses 与 /v1/messages 直接返回错误，
#        客户端必须使用 Chat Completions 协议（如 opencode 的 openai 兼容 provider）
# false = 各端点按上面规则正常处理
ZEN_FORCE_CHAT_INBOUND=false
# 允许反代的模型，逗号分隔（可选；留空 = 不做限制全部放行）
ZEN_MODELS=deepseek-v4-flash-free,mimo-v2.5-free
# 模型别名映射 alias=上游模型，逗号分隔（可选）
ZEN_MODEL_MAP=
# 模型 -> 上游协议覆盖，逗号分隔（可选）：model=chat|responses|messages|gemini
# 默认按 opencode zen 官方模型表自动决定：gpt/grok/muse -> responses，claude/qwen3 -> messages，
# gemini -> gemini（/models/<id>），deepseek/minimax/glm/kimi/免费模型 -> chat
ZEN_MODEL_ENDPOINTS=
# 别人调用本反代需要带的 key（可选；留空 = 无需鉴权）
ZEN_AUTH_KEY=
# 上游 429 时的重试策略
ZEN_RETRY_MAX=3
ZEN_RETRY_BACKOFF_SECONDS=2
ZEN_RETRY_MAX_BACKOFF_SECONDS=30
# 熔断：连续 429 达到该次数后，冷却期内不再请求上游
ZEN_CIRCUIT_FAILURES=5
ZEN_CIRCUIT_COOLDOWN_SECONDS=30
# 单请求体上限（MB）
ZEN_MAX_BODY_MB=128
# 非流式请求的上游超时（秒）；0 = 不限制
ZEN_UPSTREAM_TIMEOUT_SECONDS=600
# 并发上限（0 = 不限制）
ZEN_MAX_CONCURRENCY=0
LOG_LEVEL=info

# ---------- Status UI（独立于反代后端的前端状态页，可选） ----------
# 监听地址（容器内固定 8090，主机端口见 docker-compose 的 STATUS_UI_PORT）
STATUS_LISTEN_ADDR=:8090
# 与反代 /debug/modes 校准的间隔（秒）
STATUS_INTERVAL=15
# 代理基础地址（用于 /debug/modes 校准）：compose 内部用 http://zenproxy:8080
STATUS_PROXY=http://127.0.0.1:8080
# 代理若配置了 ZEN_AUTH_KEY，这里填同一个值以便校准请求通过鉴权
STATUS_PROXY_AUTH=
# 上报事件校验 token（与 ZEN_STATUS_TOKEN 一致，可选）
STATUS_EVENT_TOKEN=
# 服务端保留的时间线窗口（秒）：默认 120（与 24h 前端默认窗口一致时按 24h 处理；
# 设为其他值时按该秒数窗口）。页面默认显示近 24 小时，切换按钮可看全部历史；
# 页面同时把快照写入浏览器 localStorage（仅保留近 24 小时），刷新/重启后仍可回看。
STATUS_HISTORY=120
